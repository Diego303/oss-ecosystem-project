---
import { type Lang, getTranslations } from '../i18n/translations';
import type { UseCase } from '../data/use-cases';
import Nav from './Nav.astro';
import Footer from './Footer.astro';

interface Props {
  useCase: UseCase;
  lang: Lang;
}

const { useCase, lang } = Astro.props;
const t = getTranslations(lang);
const base = import.meta.env.BASE_URL;
const uc = useCase[lang];
const listHref = lang === 'en' ? `${base}en/use-cases/` : `${base}casos-de-uso/`;

const priorityMap = {
  critical: { label: t.useCases.priorityCritical, color: '#FF0000' },
  high: { label: t.useCases.priorityHigh, color: '#C85A32' },
  medium: { label: t.useCases.priorityMedium, color: 'rgba(255,255,255,0.5)' },
  low: { label: t.useCases.priorityLow, color: 'rgba(255,255,255,0.25)' },
};
const priority = priorityMap[useCase.licitPriority];

const toolMeta: Record<string, { symbol: string; color: string; phaseLabel: string }> = {
  intake: { symbol: '\u25FB', color: '#ededed', phaseLabel: 'intake' },
  architect: { symbol: '\u25B3', color: '#C85A32', phaseLabel: 'architect' },
  vigil: { symbol: '\u25C7', color: '#10B981', phaseLabel: 'vigil' },
  licit: { symbol: '\u2B21', color: '#FF0000', phaseLabel: 'licit' },
};

function stars(n: number): string {
  return '\u2605'.repeat(n) + '\u2606'.repeat(3 - n);
}
---

<Nav lang={lang} isHome={false} />

<main class="uc-detail">
  <!-- Back link -->
  <section class="uc-back-section">
    <div class="container">
      <a href={listHref} class="uc-back">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.5" fill="none"/>
        </svg>
        {t.useCases.backToList}
      </a>
    </div>
  </section>

  <!-- Header -->
  <section class="uc-header">
    <div class="container">
      <div class="uc-header-meta">
        <span class="uc-header-num">{String(useCase.number).padStart(2, '0')}</span>
        <span class="uc-header-sector">{useCase.sector[lang]}</span>
        <span class="uc-header-category">
          {useCase.category === 'regulated' ? t.useCases.regulated : t.useCases.devops}
        </span>
        <span class="uc-header-priority" style={`color: ${priority.color}; border-color: ${priority.color}`}>
          {priority.label}
        </span>
      </div>
      <h1 class="uc-header-title">{uc.title}</h1>
      <p class="uc-header-desc">{uc.shortDescription}</p>

      <!-- Tool usage bar -->
      <div class="uc-tool-bar">
        {Object.entries(useCase.tools).map(([tool, rating]) => {
          const meta = toolMeta[tool];
          return (
            <div class="uc-tool-item" style={`border-color: ${meta.color}30`}>
              <span class="uc-tool-sym" style={`color: ${meta.color}`}>{meta.symbol}</span>
              <span class="uc-tool-name" style={`color: ${meta.color}`}>{meta.phaseLabel}</span>
              <span class="uc-tool-stars" style={`color: ${meta.color}88`}>{stars(rating)}</span>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Diagram -->
  {useCase.diagramFile && (
    <section class="uc-diagram-section">
      <div class="container">
        <div class="uc-diagram-label">{t.useCases.diagram}</div>
        <div class="uc-diagram-frame">
          <iframe
            src={`${base}diagrams/${useCase.diagramFile}`}
            title={uc.title}
            loading="lazy"
          ></iframe>
        </div>
      </div>
    </section>
  )}

  <!-- Context -->
  <section class="uc-context">
    <div class="container">
      <div class="uc-section-tag">{t.useCases.context}</div>
      <p class="uc-context-text">{uc.context}</p>
    </div>
  </section>

  <!-- Flow phases -->
  <section class="uc-flow">
    <div class="container">
      <div class="uc-section-tag">{t.useCases.flow}</div>
      <div class="uc-phases">
        {uc.phases.map((phase, i) => {
          const meta = toolMeta[phase.tool];
          return (
            <div class="uc-phase">
              <div class="uc-phase-header">
                <span class="uc-phase-sym" style={`color: ${meta.color}`}>{meta.symbol}</span>
                <span class="uc-phase-label" style={`color: ${meta.color}88`}>
                  {t.useCases.phase} {String(i + 1).padStart(2, '0')}
                </span>
                <span class="uc-phase-sep">—</span>
                <span class="uc-phase-tool" style={`color: ${meta.color}`}>{phase.tool}</span>
              </div>
              <h3 class="uc-phase-title">{phase.title}</h3>
              <p class="uc-phase-desc">{phase.description}</p>
              {phase.code && (
                <div class="uc-code" style={`border-color: ${meta.color}33; box-shadow: 6px 6px 0 0 ${meta.color}15`}>
                  <div class="uc-code-header" style={`border-color: ${meta.color}33`}>
                    <span style={`color: ${meta.color}66`}>{meta.symbol} {phase.tool}</span>
                  </div>
                  <pre class="uc-code-body"><code set:html={phase.code} /></pre>
                </div>
              )}
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- CI/CD -->
  {uc.cicd && (
    <section class="uc-cicd">
      <div class="container">
        <div class="uc-section-tag">{t.useCases.cicdTitle}</div>
        <div class="uc-code" style="border-color: rgba(255,255,255,0.12); box-shadow: 6px 6px 0 0 rgba(255,255,255,0.04)">
          <div class="uc-code-header" style="border-color: rgba(255,255,255,0.08)">
            <span style="color: rgba(255,255,255,0.35)">{uc.cicd.title}</span>
          </div>
          <pre class="uc-code-body"><code set:html={uc.cicd.code} /></pre>
        </div>
      </div>
    </section>
  )}

  <!-- Why licit -->
  {uc.whyLicit && (
    <section class="uc-why-licit">
      <div class="container">
        <div class="uc-section-tag" style="color: rgba(255,0,0,0.35)">{t.useCases.whyLicitTitle}</div>
        <p class="uc-why-text">{uc.whyLicit}</p>
      </div>
    </section>
  )}
</main>

<Footer lang={lang} />

<style>
  .uc-detail {
    background: #0a0a0c;
    min-height: 100vh;
  }

  .uc-back-section {
    padding-top: 72px;
    padding-bottom: 0;
  }

  .uc-back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--f-mono);
    font-size: 11px;
    color: rgba(255, 255, 255, 0.35);
    text-decoration: none;
    letter-spacing: 0.06em;
    transition: color 0.15s;
  }

  .uc-back:hover {
    color: rgba(255, 255, 255, 0.7);
  }

  .uc-header {
    padding: 40px 0 0;
    animation: fadeUp 0.5s ease-out both;
  }

  .uc-header-meta {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 18px;
    flex-wrap: wrap;
  }

  .uc-header-num {
    font-family: var(--f-mono);
    font-size: 12px;
    color: rgba(255, 255, 255, 0.15);
    letter-spacing: 0.15em;
  }

  .uc-header-sector {
    font-family: var(--f-mono);
    font-size: 10px;
    color: rgba(255, 255, 255, 0.3);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 3px 10px;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .uc-header-category {
    font-family: var(--f-mono);
    font-size: 10px;
    color: rgba(255, 255, 255, 0.25);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .uc-header-priority {
    font-family: var(--f-mono);
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 3px 10px;
    border: 1px solid;
    opacity: 0.6;
  }

  .uc-header-title {
    font-family: var(--f-head);
    font-size: clamp(24px, 3.5vw, 36px);
    font-weight: 700;
    color: #ededed;
    letter-spacing: -0.03em;
    line-height: 1.12;
    margin-bottom: 14px;
  }

  .uc-header-desc {
    font-family: var(--f-body);
    font-size: 15px;
    font-weight: 300;
    color: rgba(255, 255, 255, 0.45);
    line-height: 1.7;
    max-width: 700px;
    margin-bottom: 32px;
  }

  .uc-tool-bar {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    padding-bottom: 40px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .uc-tool-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border: 1px solid;
  }

  .uc-tool-sym {
    font-size: 10px;
  }

  .uc-tool-name {
    font-family: var(--f-head);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .uc-tool-stars {
    font-family: var(--f-mono);
    font-size: 10px;
  }

  /* Diagram */
  .uc-diagram-section {
    padding: 48px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .uc-diagram-label {
    font-family: var(--f-mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.25);
    margin-bottom: 16px;
  }

  .uc-diagram-frame {
    border: 2px solid rgba(255, 255, 255, 0.08);
    background: #0a0a0c;
    overflow: hidden;
  }

  .uc-diagram-frame iframe {
    width: 100%;
    height: 520px;
    border: none;
    display: block;
  }

  /* Section tags */
  .uc-section-tag {
    font-family: var(--f-mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.25);
    margin-bottom: 20px;
  }

  /* Context */
  .uc-context {
    padding: 48px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .uc-context-text {
    font-family: var(--f-body);
    font-size: 15px;
    font-weight: 300;
    color: rgba(255, 255, 255, 0.5);
    line-height: 1.75;
    max-width: 800px;
  }

  /* Flow phases */
  .uc-flow {
    padding: 48px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .uc-phases {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .uc-phase {
    animation: fadeUp 0.5s ease-out both;
  }

  .uc-phase-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
  }

  .uc-phase-sym {
    font-size: 10px;
  }

  .uc-phase-label {
    font-family: var(--f-mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .uc-phase-sep {
    color: rgba(255, 255, 255, 0.15);
    font-size: 12px;
  }

  .uc-phase-tool {
    font-family: var(--f-head);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .uc-phase-title {
    font-family: var(--f-head);
    font-size: 18px;
    font-weight: 700;
    color: #ededed;
    letter-spacing: -0.02em;
    margin-bottom: 8px;
  }

  .uc-phase-desc {
    font-family: var(--f-body);
    font-size: 14px;
    font-weight: 300;
    color: rgba(255, 255, 255, 0.45);
    line-height: 1.7;
    max-width: 700px;
    margin-bottom: 18px;
  }

  /* Code blocks */
  .uc-code {
    border: 2px solid;
    max-width: 800px;
  }

  .uc-code-header {
    padding: 8px 16px;
    border-bottom: 1px solid;
    font-family: var(--f-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .uc-code-body {
    padding: 18px;
    margin: 0;
    overflow-x: auto;
    background: rgba(255, 255, 255, 0.01);
  }

  .uc-code-body code {
    font-family: var(--f-mono);
    font-size: 12.5px;
    line-height: 1.9;
    color: rgba(255, 255, 255, 0.55);
    white-space: pre;
  }

  /* CI/CD */
  .uc-cicd {
    padding: 48px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  /* Why licit */
  .uc-why-licit {
    padding: 48px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    background-image: radial-gradient(ellipse 500px 300px at 25% 50%, rgba(255, 0, 0, 0.02), transparent);
  }

  .uc-why-text {
    font-family: var(--f-body);
    font-size: 15px;
    font-weight: 300;
    color: rgba(255, 255, 255, 0.5);
    line-height: 1.75;
    max-width: 800px;
  }

  @media (max-width: 900px) {
    .uc-tool-bar {
      gap: 8px;
    }

    .uc-diagram-frame iframe {
      height: 400px;
    }
  }

  @media (max-width: 600px) {
    .uc-tool-bar {
      flex-direction: column;
    }

    .uc-header-meta {
      gap: 8px;
    }

    .uc-diagram-frame iframe {
      height: 320px;
    }
  }
</style>
