---
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import JourneyStop from './JourneyStop.astro';
import CodeBlock from './CodeBlock.astro';
import FeatureList from './FeatureList.astro';
import SectionHeader from './SectionHeader.astro';
import PrincipleCard from './PrincipleCard.astro';
import SquareIcon from './icons/SquareIcon.astro';
import TriangleIcon from './icons/TriangleIcon.astro';
import DiamondIcon from './icons/DiamondIcon.astro';
import HexagonIcon from './icons/HexagonIcon.astro';
import { type Lang, getTranslations } from '../i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
---

<Nav lang={lang} />

<!-- HERO -->
<section class="hero">
  <div class="container">
    <div class="hero-top">
      <div class="hero-tag">{t.hero.tag}</div>
      <h1>{t.hero.titleStart}<span class="accent-green">{t.hero.titleAccent}</span></h1>
      <p class="hero-subtitle">{t.hero.subtitle}</p>
      <div class="hero-buttons">
        <a href="#sec-i" class="btn btn-primary">{t.hero.cta}</a>
      </div>
    </div>

    <!-- Licit compliance frame wrapping the journey -->
    <div class="licit-frame">
      <div class="licit-frame-label">{t.hero.licitFrameLabel}</div>
      <div class="licit-stop">
        <a href="https://diego303.github.io/licit-docs/" target="_blank" rel="noopener noreferrer" class="licit-stop-dot">
          <HexagonIcon />
        </a>
        <div class="licit-stop-phase">{t.journey.licit.phase}</div>
        <div class="licit-stop-name">licit</div>
        <div class="licit-stop-tag">{t.journey.licit.tag}</div>
        <p class="licit-stop-desc">{t.journey.licit.description}</p>
      </div>

      <div class="journey">
        <svg class="journey-svg" id="journeySvg">
          <defs>
            <linearGradient id="pathGrad" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#ededed" />
              <stop offset="50%" stop-color="#C85A32" />
              <stop offset="100%" stop-color="#10B981" />
            </linearGradient>
          </defs>
          <path id="pathDash" fill="none" stroke="rgba(255,255,255,0.07)" stroke-width="2" stroke-dasharray="6 6" />
          <path id="pathGlow" fill="none" stroke="url(#pathGrad)" stroke-width="2" opacity="0.45" class="journey-line" />
          <g id="dotsContainer"></g>
        </svg>

        <div class="journey-stops">
          <JourneyStop
            variant="intake"
            phase={t.journey.intake.phase}
            name="intake"
            tag={t.journey.intake.tag}
            description={t.journey.intake.description}
            href="https://diego303.github.io/intake-docs/"
          >
            <SquareIcon />
          </JourneyStop>

          <JourneyStop
            variant="architect"
            phase={t.journey.architect.phase}
            name="architect"
            tag={t.journey.architect.tag}
            description={t.journey.architect.description}
            href="https://diego303.github.io/architect-docs/"
          >
            <TriangleIcon />
          </JourneyStop>

          <JourneyStop
            variant="vigil"
            phase={t.journey.vigil.phase}
            name="vigil"
            tag={t.journey.vigil.tag}
            description={t.journey.vigil.description}
            href="https://diego303.github.io/vigil-docs/"
          >
            <DiamondIcon />
          </JourneyStop>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- INTAKE -->
<section class="sec-intake" id="sec-i">
  <div class="container">
    <div class="tool-grid">
      <div>
        <div class="phase">{t.intake.phase}</div>
        <h3>intake</h3>
        <div class="tool-subtitle">{t.intake.subtitle}</div>
        <p>{t.intake.p1}</p>
        <p>{t.intake.p2}</p>
        <FeatureList variant="intake" items={t.intake.features} />
        <a href="https://diego303.github.io/intake-docs/" target="_blank" rel="noopener noreferrer" class="btn btn-tool btn-tool--intake">{t.intake.docBtn}</a>
      </div>
      <CodeBlock variant="dark" title={t.intake.codeTitle}>
        <span class="line"><span class="cm">{t.intake.code.comment}</span></span>
        <span class="line"><span class="pr">$ </span><span class="cmd">intake</span> <span class="fl">collect</span></span>
        <span class="line"><span class="fl">  --from</span> <span class="s">jira:PROJ-123</span></span>
        <span class="line"><span class="fl">  --from</span> <span class="s">pdf:specs/req.pdf</span></span>
        <span class="line"><span class="fl">  --from</span> <span class="s">slack:#dev</span></span>
        <span class="line"></span>
        <span class="line"><span class="o">{t.intake.code.output1}</span></span>
        <span class="line"><span class="o">{t.intake.code.output2}</span></span>
      </CodeBlock>
    </div>
  </div>
</section>

<!-- ARCHITECT -->
<section class="sec-architect" id="sec-a">
  <div class="container">
    <div class="tool-grid tool-grid--reversed">
      <div>
        <div class="phase">{t.architect.phase}</div>
        <h3>architect</h3>
        <div class="tool-subtitle">{t.architect.subtitle}</div>
        <p>{t.architect.p1}</p>
        <FeatureList variant="architect" items={t.architect.features} />
        <a href="https://diego303.github.io/architect-docs/" target="_blank" rel="noopener noreferrer" class="btn btn-tool btn-tool--architect">{t.architect.docBtn}</a>
      </div>
      <CodeBlock variant="warm" title={t.architect.codeTitle}>
        <span class="line"><span class="pr">$ </span><span class="cmd">architect</span> <span class="fl">loop</span> <span class="s">"{t.architect.code.arg}"</span></span>
        <span class="line"><span class="fl">  --check</span> <span class="s">"pytest tests/ -q"</span></span>
        <span class="line"><span class="fl">  --check</span> <span class="s">"vigil scan src/"</span></span>
        <span class="line"><span class="fl">  --budget</span> <span class="s">$2.00</span></span>
        <span class="line"></span>
        <span class="line"><span class="o">{t.architect.code.output1}</span></span>
        <span class="line"><span class="o">{t.architect.code.output2}</span></span>
      </CodeBlock>
    </div>
  </div>
</section>

<!-- VIGIL -->
<section class="sec-vigil" id="sec-v">
  <div class="container">
    <div class="tool-grid">
      <div>
        <div class="phase">{t.vigil.phase}</div>
        <h3>vigil</h3>
        <div class="tool-subtitle">{t.vigil.subtitle}</div>
        <p>{t.vigil.p1}</p>
        <FeatureList variant="vigil" items={t.vigil.features} />
        <a href="https://diego303.github.io/vigil-docs/" target="_blank" rel="noopener noreferrer" class="btn btn-tool btn-tool--vigil">{t.vigil.docBtn}</a>
      </div>
      <CodeBlock variant="green" title={t.vigil.codeTitle}>
        <span class="line"><span class="pr">$ </span><span class="cmd">vigil</span> <span class="fl">scan</span> <span class="s">src/</span></span>
        <span class="line"></span>
        <span class="line"><span class="o">{t.vigil.code.output1}</span></span>
        <span class="line" style="color:#EF4444">{t.vigil.code.error1}</span>
        <span class="line" style="color:#EF4444">{t.vigil.code.error2}</span>
        <span class="line" style="color:#10B981">{t.vigil.code.ok}</span>
      </CodeBlock>
    </div>
  </div>
</section>

<!-- LICIT -->
<section class="sec-licit" id="sec-l">
  <div class="container">
    <div class="tool-grid tool-grid--reversed">
      <div>
        <div class="phase">{t.licit.phase}</div>
        <h3>licit</h3>
        <div class="tool-subtitle">{t.licit.subtitle}</div>
        <p>{t.licit.p1}</p>
        <p>{t.licit.p2}</p>
        <FeatureList variant="licit" items={t.licit.features} />
        <a href="https://diego303.github.io/licit-docs/" target="_blank" rel="noopener noreferrer" class="btn btn-tool btn-tool--licit">{t.licit.docBtn}</a>
      </div>
      <CodeBlock variant="white" title={t.licit.codeTitle}>
        <span class="line"><span class="cm">{t.licit.code.comment}</span></span>
        <span class="line"><span class="pr">$ </span><span class="cmd">licit</span> <span class="fl">init</span></span>
        <span class="line"><span class="o">{t.licit.code.initOutput1}</span></span>
        <span class="line"><span class="o">{t.licit.code.initOutput2}</span></span>
        <span class="line"></span>
        <span class="line"><span class="pr">$ </span><span class="cmd">licit</span> <span class="fl">trace</span></span>
        <span class="line"><span class="o">{t.licit.code.traceOutput}</span></span>
        <span class="line"></span>
        <span class="line"><span class="pr">$ </span><span class="cmd">licit</span> <span class="fl">verify</span></span>
        <span class="line"><span class="o">{t.licit.code.verifyOutput1}</span></span>
        <span class="line"><span class="o">{t.licit.code.verifyOutput2}</span></span>
        <span class="line" style="color:#FF0000">{t.licit.code.verifyStatus}</span>
      </CodeBlock>
    </div>
  </div>
</section>

<!-- PIPELINE -->
<section class="sec-pipeline">
  <div class="container">
    <SectionHeader tag={t.pipeline.tag} title={t.pipeline.title} subtitle={t.pipeline.subtitle} />
    <div class="pipeline-code">
      <CodeBlock variant="dark" title={t.pipeline.codeTitle}>
        <Fragment>
          <span class="line"><span class="cm">#!/bin/bash</span></span>
          <span class="line"></span>
          <span class="line"><span class="cmd">intake</span> <span class="fl">collect --from</span> <span class="s">jira:SPRINT-42</span> <span class="fl">--out</span> <span class="s">spec.yaml</span></span>
          <span class="line"></span>
          <span class="line"><span class="cmd" style="color:#C85A32">architect</span> <span class="fl">loop</span> <span class="s">"{t.pipeline.code.arg}"</span> <span class="fl">\</span></span>
          <span class="line">  <span class="fl">--check</span> <span class="s">"pytest && vigil scan src/"</span></span>
          <span class="line"></span>
          <span class="line"><span class="cmd" style="color:#10B981">vigil</span> <span class="fl">scan src/ --format junit</span></span>
          <span class="line"></span>
          <span class="line"><span class="cmd" style="color:#FF0000">licit</span> <span class="fl">verify --fail-on</span> <span class="s">high</span></span>
        </Fragment>
      </CodeBlock>
    </div>
  </div>
</section>

<!-- PRINCIPLES -->
<section class="sec-principles">
  <div class="container">
    <SectionHeader tag={t.principles.tag} title={t.principles.title} />
    <div class="principles-grid">
      {t.principles.items.map((p) => (
        <PrincipleCard number={p.number} title={p.title} description={p.description} />
      ))}
    </div>
  </div>
</section>

<!-- CTA -->
<section class="sec-cta" id="cta">
  <div class="container">
    <h2>{t.cta.title}</h2>
    <p>{t.cta.subtitle}</p>
    <div class="cta-buttons">
      <a href="#" class="btn btn-primary">{t.cta.btn}</a>
    </div>
  </div>
</section>

<Footer lang={lang} />

<style>
  /* ═══ HERO ═══ */
  .hero {
    background: #0a0a0c;
    color: #ededed;
    padding: 130px 0 60px;
    background-image: radial-gradient(
      ellipse 600px 400px at 50% 40%,
      rgba(200, 90, 50, 0.04),
      transparent
    );
  }

  .hero-top {
    text-align: center;
    margin-bottom: 64px;
    animation: fadeUp 0.5s ease-out both;
  }

  .hero-tag {
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.35);
    margin-bottom: 28px;
  }

  .hero h1 {
    font-family: var(--f-head);
    font-size: clamp(34px, 5vw, 56px);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.08;
    max-width: 680px;
    margin: 0 auto 20px;
  }

  .accent-green {
    color: #10B981;
  }

  .hero-subtitle {
    font-size: 17px;
    color: rgba(255, 255, 255, 0.5);
    max-width: 500px;
    margin: 0 auto 36px;
    font-weight: 300;
    line-height: 1.75;
  }

  .hero-buttons {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ═══ Licit Frame ═══ */
  .licit-frame {
    position: relative;
    max-width: 960px;
    margin: 40px auto 0;
    padding: 200px 28px 28px;
    border: 2px dashed rgba(255, 0, 0, 0.15);
    animation: fadeUp 0.5s ease-out 0.15s both;
  }

  .licit-frame-label {
    position: absolute;
    top: -1px;
    left: 24px;
    background: #0a0a0c;
    padding: 0 12px;
    font-family: var(--f-mono);
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 0, 0, 0.35);
    transform: translateY(-50%);
  }

  .licit-stop {
    position: absolute;
    top: 20px;
    right: 28px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    z-index: 3;
  }

  .licit-stop-dot {
    width: 64px;
    height: 64px;
    border: 2px solid rgba(255, 0, 0, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
    position: relative;
    background: transparent;
    text-decoration: none;
    cursor: pointer;
    transition: border-color 0.2s;
  }

  .licit-stop-dot:hover {
    border-color: rgba(255, 0, 0, 0.5);
  }

  .licit-stop-dot::before {
    content: '';
    position: absolute;
    inset: -6px;
    border: 1px solid rgba(255, 0, 0, 0.05);
  }

  .licit-stop-phase {
    font-family: var(--f-mono);
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.25);
    margin-bottom: 6px;
  }

  .licit-stop-name {
    font-family: var(--f-head);
    font-size: 20px;
    font-weight: 700;
    color: #FF0000;
    margin-bottom: 4px;
  }

  .licit-stop-tag {
    font-family: var(--f-mono);
    font-size: 10px;
    color: rgba(255, 255, 255, 0.3);
    letter-spacing: 0.06em;
    margin-bottom: 10px;
  }

  .licit-stop-desc {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.4);
    line-height: 1.55;
    font-weight: 300;
    max-width: 200px;
  }

  .licit-frame .journey {
    max-width: none;
    margin: 0;
    padding: 20px 0 20px;
  }

  /* ═══ Journey Map ═══ */
  .journey {
    position: relative;
    max-width: 900px;
    margin: 0 auto;
    padding: 20px 0 40px;
  }

  .journey-svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  .journey-stops {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    position: relative;
    z-index: 2;
  }

  /* ═══ TOOL SECTIONS — Shared ═══ */
  .tool-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
  }

  .tool-grid--reversed {
    direction: rtl;
  }

  .tool-grid--reversed > :global(*) {
    direction: ltr;
  }

  .phase {
    font-family: var(--f-mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .tool-subtitle {
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 20px;
  }

  .btn-tool {
    margin-top: 24px;
    border: 1px solid;
  }

  .btn-tool--intake {
    color: #ededed;
    border-color: rgba(237, 237, 237, 0.2);
  }
  .btn-tool--intake:hover {
    border-color: rgba(237, 237, 237, 0.4);
  }

  .btn-tool--architect {
    color: #C85A32;
    border-color: rgba(200, 90, 50, 0.3);
  }
  .btn-tool--architect:hover {
    border-color: rgba(200, 90, 50, 0.5);
  }

  .btn-tool--vigil {
    color: #10B981;
    border-color: rgba(16, 185, 129, 0.3);
  }
  .btn-tool--vigil:hover {
    border-color: rgba(16, 185, 129, 0.5);
  }

  .btn-tool--licit {
    color: #FF0000;
    border-color: rgba(255, 0, 0, 0.3);
  }
  .btn-tool--licit:hover {
    border-color: rgba(255, 0, 0, 0.5);
  }

  /* ═══ INTAKE ═══ */
  .sec-intake {
    background: #050505;
    color: #ededed;
    padding: 100px 0;
    border-top: 2px solid #1f1f22;
    background-image: radial-gradient(
      ellipse 500px 300px at 25% 50%,
      rgba(237, 237, 237, 0.02),
      transparent
    );
  }

  .sec-intake .phase { color: #5a5a66; }
  .sec-intake h3 {
    font-family: var(--f-head);
    font-size: 32px;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #ededed;
    margin-bottom: 6px;
  }
  .sec-intake .tool-subtitle { color: #5a5a66; }
  .sec-intake p {
    font-size: 15px;
    color: #9999a5;
    line-height: 1.75;
    margin-bottom: 14px;
    font-weight: 300;
  }

  /* ═══ ARCHITECT ═══ */
  .sec-architect {
    background: #FDFBF7;
    color: #292524;
    padding: 100px 0;
    border-top: 2px solid #292524;
    background-image: radial-gradient(
      ellipse 500px 300px at 75% 50%,
      rgba(200, 90, 50, 0.04),
      transparent
    );
  }

  .sec-architect .phase { color: #57534E; }
  .sec-architect h3 {
    font-family: var(--f-head);
    font-size: 32px;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #C85A32;
    margin-bottom: 6px;
  }
  .sec-architect .tool-subtitle { color: #C85A32; }
  .sec-architect p {
    font-size: 15px;
    color: #57534E;
    line-height: 1.75;
    margin-bottom: 14px;
    font-weight: 300;
  }

  /* ═══ VIGIL ═══ */
  .sec-vigil {
    background: #F4F7F5;
    color: #022C22;
    padding: 100px 0;
    border-top: 2px solid #022C22;
    background-image: radial-gradient(
      ellipse 500px 300px at 25% 50%,
      rgba(16, 185, 129, 0.04),
      transparent
    );
  }

  .sec-vigil .phase { color: #064E3B; }
  .sec-vigil h3 {
    font-family: var(--f-head);
    font-size: 32px;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #064E3B;
    margin-bottom: 6px;
  }
  .sec-vigil .tool-subtitle { color: #10B981; }
  .sec-vigil p {
    font-size: 15px;
    color: #064E3B;
    line-height: 1.75;
    margin-bottom: 14px;
    font-weight: 300;
  }

  /* ═══ LICIT ═══ */
  .sec-licit {
    background: #FFFFFF;
    color: #000;
    padding: 100px 0;
    border-top: 3px solid #FF0000;
    background-image: radial-gradient(
      ellipse 500px 300px at 75% 50%,
      rgba(255, 0, 0, 0.02),
      transparent
    );
  }

  .sec-licit .phase { color: #999; }
  .sec-licit h3 {
    font-family: var(--f-head);
    font-size: 32px;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #000;
    margin-bottom: 6px;
  }
  .sec-licit .tool-subtitle { color: #FF0000; }
  .sec-licit p {
    font-size: 15px;
    color: #444;
    line-height: 1.75;
    margin-bottom: 14px;
    font-weight: 300;
  }

  /* ═══ PIPELINE ═══ */
  .sec-pipeline {
    background: #0a0a0c;
    color: #ededed;
    padding: 100px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .pipeline-code {
    max-width: 680px;
    margin: 0 auto;
  }

  .pipeline-code :global(.cb-body) {
    line-height: 2;
  }

  /* ═══ PRINCIPLES ═══ */
  .sec-principles {
    background: #111114;
    color: #ededed;
    padding: 80px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .principles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }

  /* ═══ CTA ═══ */
  .sec-cta {
    background: #0a0a0c;
    color: #ededed;
    padding: 100px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    text-align: center;
  }

  .sec-cta h2 {
    font-family: var(--f-head);
    font-size: clamp(26px, 3.5vw, 40px);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: 16px;
  }

  .sec-cta p {
    font-size: 15px;
    color: rgba(255, 255, 255, 0.45);
    max-width: 440px;
    margin: 0 auto 32px;
    font-weight: 300;
  }

  .cta-buttons {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ═══ RESPONSIVE ═══ */
  @media (max-width: 900px) {
    .journey-stops {
      flex-direction: column;
      align-items: center;
      gap: 32px;
    }

    .journey-svg {
      display: none;
    }

    .licit-frame {
      border: none;
      padding: 0;
      margin-top: 0;
    }

    .licit-frame-label {
      display: none;
    }

    .licit-stop {
      position: static;
      padding: 0 0 16px;
    }

    .licit-frame .journey {
      padding: 0;
    }

    .tool-grid,
    .tool-grid--reversed {
      grid-template-columns: 1fr;
      gap: 32px;
      direction: ltr;
    }

    .principles-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .hero {
      padding: 110px 0 40px;
    }

    .hero-buttons {
      flex-direction: column;
      align-items: stretch;
    }

    .hero-buttons :global(.btn) {
      text-align: center;
    }
  }
</style>

<script>
  function lerpColor(a: string, b: string, t: number): string {
    const ah = parseInt(a.slice(1), 16),
      bh = parseInt(b.slice(1), 16);
    const ar = ah >> 16,
      ag = (ah >> 8) & 0xff,
      ab = ah & 0xff;
    const br = bh >> 16,
      bg = (bh >> 8) & 0xff,
      bb = bh & 0xff;
    return `rgb(${Math.round(ar + (br - ar) * t)},${Math.round(ag + (bg - ag) * t)},${Math.round(ab + (bb - ab) * t)})`;
  }

  function getPathColor(t: number): string {
    if (t <= 0.5) return lerpColor('#ededed', '#C85A32', t * 2);
    return lerpColor('#C85A32', '#10B981', (t - 0.5) * 2);
  }

  function easeInOut(t: number): number {
    return t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
  }

  const SVG_NS = 'http://www.w3.org/2000/svg';

  interface ActiveDot {
    outer: SVGCircleElement;
    inner: SVGCircleElement;
    grad: SVGRadialGradientElement;
    glowStops: NodeListOf<SVGStopElement>;
    startTime: number;
    duration: number;
  }

  let pathRef: SVGPathElement | null = null;
  let dotsStarted = false;
  const activeDots: ActiveDot[] = [];

  function drawJourneyPath() {
    const journey = document.querySelector('.journey');
    const dots = document.querySelectorAll('.journey-stops .stop-dot, .journey-stops .stop-dot--link');
    const svg = document.getElementById('journeySvg');
    const pathDash = document.getElementById('pathDash');
    const pathGlow = document.getElementById('pathGlow') as SVGPathElement | null;
    if (!journey || dots.length < 3 || !svg || !pathDash || !pathGlow) return;

    const jRect = journey.getBoundingClientRect();
    const centers = Array.from(dots).map((dot) => {
      const r = dot.getBoundingClientRect();
      return {
        x: r.left + r.width / 2 - jRect.left,
        y: r.top + r.height / 2 - jRect.top,
      };
    });

    const [a, b, c] = centers;
    const cp1x = a.x + (b.x - a.x) * 0.55,
      cp1y = a.y;
    const cp2x = a.x + (b.x - a.x) * 0.45,
      cp2y = b.y;
    const cp3x = b.x + (c.x - b.x) * 0.55,
      cp3y = b.y;
    const cp4x = b.x + (c.x - b.x) * 0.45,
      cp4y = c.y;
    const d = `M ${a.x} ${a.y} C ${cp1x} ${cp1y}, ${cp2x} ${cp2y}, ${b.x} ${b.y} C ${cp3x} ${cp3y}, ${cp4x} ${cp4y}, ${c.x} ${c.y}`;

    pathDash.setAttribute('d', d);
    pathGlow.setAttribute('d', d);

    const len = pathGlow.getTotalLength();
    pathGlow.style.strokeDasharray = String(len);
    pathGlow.style.strokeDashoffset = String(len);
    pathGlow.style.animation = 'none';
    pathGlow.offsetHeight;
    pathGlow.style.animation = 'drawPath 1.5s ease-out 0.3s forwards';

    pathRef = pathGlow;

    if (!dotsStarted) {
      dotsStarted = true;
      setTimeout(() => {
        startDotLoop();
        requestAnimationFrame(animateAllDots);
      }, 1800);
    }
  }

  function spawnDot() {
    if (!pathRef) return;
    const container = document.getElementById('dotsContainer');
    const defs = document.querySelector('#journeySvg defs');
    if (!container || !defs) return;

    const duration = 3500 + Math.random() * 2000;
    const outerR = 10 + Math.random() * 5;
    const innerR = 2.5 + Math.random() * 1.5;
    const id = 'dg' + Math.random().toString(36).slice(2, 8);

    const grad = document.createElementNS(SVG_NS, 'radialGradient');
    grad.setAttribute('id', id);

    const s1 = document.createElementNS(SVG_NS, 'stop');
    s1.setAttribute('offset', '0%');
    s1.setAttribute('stop-color', '#ededed');
    s1.setAttribute('stop-opacity', '0.9');

    const s2 = document.createElementNS(SVG_NS, 'stop');
    s2.setAttribute('offset', '40%');
    s2.setAttribute('stop-color', '#ededed');
    s2.setAttribute('stop-opacity', '0.3');

    const s3 = document.createElementNS(SVG_NS, 'stop');
    s3.setAttribute('offset', '100%');
    s3.setAttribute('stop-color', '#ededed');
    s3.setAttribute('stop-opacity', '0');

    grad.appendChild(s1);
    grad.appendChild(s2);
    grad.appendChild(s3);
    defs.appendChild(grad);

    const outer = document.createElementNS(SVG_NS, 'circle');
    outer.setAttribute('r', String(outerR));
    outer.setAttribute('fill', `url(#${id})`);
    outer.setAttribute('opacity', '0');

    const inner = document.createElementNS(SVG_NS, 'circle');
    inner.setAttribute('r', String(innerR));
    inner.setAttribute('fill', '#ededed');
    inner.setAttribute('opacity', '0');

    container.appendChild(outer);
    container.appendChild(inner);

    activeDots.push({
      outer,
      inner,
      grad,
      glowStops: grad.querySelectorAll('stop'),
      startTime: performance.now(),
      duration,
    });
  }

  function startDotLoop() {
    spawnDot();

    function scheduleNext() {
      const delay = 1200 + Math.random() * 1800;
      setTimeout(() => {
        if (activeDots.length < 3) {
          spawnDot();
        }
        scheduleNext();
      }, delay);
    }
    scheduleNext();
  }

  function animateAllDots(timestamp: number) {
    for (let i = activeDots.length - 1; i >= 0; i--) {
      const dot = activeDots[i];
      const elapsed = timestamp - dot.startTime;
      const rawT = elapsed / dot.duration;

      if (rawT > 1.15) {
        dot.outer.remove();
        dot.inner.remove();
        dot.grad.remove();
        activeDots.splice(i, 1);
        continue;
      }

      const t = Math.min(rawT, 1);
      const eased = easeInOut(t);

      try {
        const len = pathRef!.getTotalLength();
        const point = pathRef!.getPointAtLength(eased * len);
        const color = getPathColor(eased);

        dot.outer.setAttribute('cx', String(point.x));
        dot.outer.setAttribute('cy', String(point.y));
        dot.inner.setAttribute('cx', String(point.x));
        dot.inner.setAttribute('cy', String(point.y));
        dot.inner.setAttribute('fill', color);

        dot.glowStops.forEach((stop) => {
          if (parseFloat(stop.getAttribute('stop-opacity') || '0') > 0) {
            stop.setAttribute('stop-color', color);
          }
        });

        let opacity = 1;
        if (t < 0.06) opacity = t / 0.06;
        else if (t > 0.9) opacity = Math.max(0, (1 - t) / 0.1);
        if (rawT > 1) opacity = Math.max(0, 1 - (rawT - 1) / 0.15);

        dot.outer.setAttribute('opacity', String(opacity));
        dot.inner.setAttribute('opacity', String(opacity));
      } catch {
        // Path may not be ready yet
      }
    }

    requestAnimationFrame(animateAllDots);
  }

  window.addEventListener('load', drawJourneyPath);
  window.addEventListener('resize', drawJourneyPath);
</script>
