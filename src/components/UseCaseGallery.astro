---
import { type Lang, getTranslations } from '../i18n/translations';
import { useCases } from '../data/use-cases';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import UseCaseCard from './UseCaseCard.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
---

<Nav lang={lang} isHome={false} />

<main class="uc-gallery">
  <!-- Hero -->
  <section class="uc-hero">
    <div class="container">
      <div class="sh">
        <div class="sh-tag">{t.useCases.tag}</div>
        <h1>{t.useCases.title}</h1>
        <p>{t.useCases.subtitle}</p>
      </div>

      <!-- Filter bar -->
      <div class="uc-filters">
        <button class="uc-filter active" data-filter="all">{t.useCases.all}</button>
        <button class="uc-filter" data-filter="regulated">{t.useCases.regulated}</button>
        <button class="uc-filter" data-filter="devops">{t.useCases.devops}</button>
      </div>
    </div>
  </section>

  <!-- Cards grid -->
  <section class="uc-grid-section">
    <div class="container">
      <div class="uc-grid">
        {useCases.map((uc) => (
          <UseCaseCard useCase={uc} lang={lang} />
        ))}
      </div>
    </div>
  </section>
</main>

<Footer lang={lang} />

<script>
  const filters = document.querySelectorAll('.uc-filter');
  const cards = document.querySelectorAll('.uc-card') as NodeListOf<HTMLElement>;

  filters.forEach((btn) => {
    btn.addEventListener('click', () => {
      filters.forEach((f) => f.classList.remove('active'));
      btn.classList.add('active');
      const filter = (btn as HTMLElement).dataset.filter;

      cards.forEach((card) => {
        if (filter === 'all' || card.dataset.category === filter) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>

<style>
  .uc-gallery {
    background: #0a0a0c;
    min-height: 100vh;
  }

  .uc-hero {
    padding-top: 120px;
    padding-bottom: 40px;
    background: #0a0a0c;
    background-image: radial-gradient(ellipse 600px 400px at 50% 40%, rgba(200, 90, 50, 0.04), transparent);
  }

  .sh {
    text-align: center;
    margin-bottom: 40px;
    animation: fadeUp 0.5s ease-out both;
  }

  .sh-tag {
    font-family: var(--f-mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.3);
    margin-bottom: 14px;
  }

  .sh h1 {
    font-family: var(--f-head);
    font-size: clamp(26px, 3.5vw, 38px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.08;
    color: #ededed;
    margin-bottom: 12px;
  }

  .sh p {
    color: rgba(255, 255, 255, 0.45);
    font-size: 15px;
    max-width: 520px;
    margin: 0 auto;
    font-weight: 300;
    line-height: 1.7;
  }

  .uc-filters {
    display: flex;
    justify-content: center;
    gap: 12px;
    animation: fadeUp 0.5s ease-out 0.1s both;
  }

  .uc-filter {
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 8px 20px;
    background: transparent;
    color: rgba(255, 255, 255, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.08);
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
  }

  .uc-filter:hover {
    color: rgba(255, 255, 255, 0.6);
    border-color: rgba(255, 255, 255, 0.15);
  }

  .uc-filter.active {
    color: #ededed;
    border-color: rgba(255, 255, 255, 0.3);
  }

  .uc-grid-section {
    padding: 40px 0 100px;
    background: #0a0a0c;
  }

  .uc-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    animation: fadeUp 0.5s ease-out 0.2s both;
  }

  @media (max-width: 900px) {
    .uc-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .uc-grid {
      grid-template-columns: 1fr;
    }

    .uc-filters {
      flex-wrap: wrap;
    }
  }
</style>
