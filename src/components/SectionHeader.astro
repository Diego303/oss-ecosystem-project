---
interface Props {
  tag: string;
  title: string;
  subtitle?: string;
}

const { tag, title, subtitle } = Astro.props;
---

<div class="section-header">
  <div class="sh-tag">{tag}</div>
  <h2>{title}</h2>
  {subtitle && <p>{subtitle}</p>}
</div>

<style>
  .section-header {
    text-align: center;
    margin-bottom: 48px;
  }

  .sh-tag {
    font-family: var(--f-mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.3);
    margin-bottom: 14px;
  }

  h2 {
    font-family: var(--f-head);
    font-size: clamp(26px, 3.5vw, 38px);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: 12px;
  }

  p {
    color: rgba(255, 255, 255, 0.45);
    font-size: 15px;
    max-width: 460px;
    margin: 0 auto;
    font-weight: 300;
  }
</style>
