---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import JourneyStop from '../components/JourneyStop.astro';
import CodeBlock from '../components/CodeBlock.astro';
import FeatureList from '../components/FeatureList.astro';
import SectionHeader from '../components/SectionHeader.astro';
import PrincipleCard from '../components/PrincipleCard.astro';
import SquareIcon from '../components/icons/SquareIcon.astro';
import TriangleIcon from '../components/icons/TriangleIcon.astro';
import DiamondIcon from '../components/icons/DiamondIcon.astro';
---

<Layout>
  <Nav />

  <!-- ═══ HERO ═══ -->
  <section class="hero">
    <div class="container">
      <div class="hero-top">
        <div class="hero-tag">Open Source · CLI-First · Backend-Agnostico</div>
        <h1>De requisitos caoticos a codigo <span class="accent-green">verificado</span></h1>
        <p class="hero-subtitle">Tres herramientas CLI. Un pipeline que cubre toda la cadena — desde la idea hasta codigo seguro en produccion.</p>
        <div class="hero-buttons">
          <a href="#sec-i" class="btn btn-primary">Explorar herramientas</a>
        </div>
      </div>

      <!-- Journey Map -->
      <div class="journey">
        <svg class="journey-svg" id="journeySvg">
          <defs>
            <linearGradient id="pathGrad" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#ededed" />
              <stop offset="50%" stop-color="#C85A32" />
              <stop offset="100%" stop-color="#10B981" />
            </linearGradient>
          </defs>
          <path id="pathDash" fill="none" stroke="rgba(255,255,255,0.07)" stroke-width="2" stroke-dasharray="6 6" />
          <path id="pathGlow" fill="none" stroke="url(#pathGrad)" stroke-width="2" opacity="0.45" class="journey-line" />
          <g id="dotsContainer"></g>
        </svg>

        <div class="journey-stops">
          <JourneyStop
            variant="intake"
            phase="Fase 01"
            name="intake"
            tag="Captura y normaliza"
            description="De Jira, PDFs, Slack o una frase — a una spec YAML ejecutable para cualquier agente."
            href="https://diego303.github.io/intake-docs/"
          >
            <SquareIcon />
          </JourneyStop>

          <JourneyStop
            variant="architect"
            phase="Fase 02"
            name="architect"
            tag="Implementa con control"
            description="Agentes de IA con guardrails deterministas, budget limits, y audit trail. Backend-agnostico."
            href="https://diego303.github.io/architect-docs/"
          >
            <TriangleIcon />
          </JourneyStop>

          <JourneyStop
            variant="vigil"
            phase="Fase 03"
            name="vigil"
            tag="Verifica y protege"
            description="Detecta vulnerabilidades exclusivas de codigo IA: alucinaciones, slopsquatting, over-permissions."
            href="https://diego303.github.io/vigil-docs/"
          >
            <DiamondIcon />
          </JourneyStop>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ INTAKE ═══ -->
  <section class="sec-intake" id="sec-i">
    <div class="container">
      <div class="tool-grid">
        <div>
          <div class="phase">&#9723; Fase 01 — Preparacion</div>
          <h3>intake</h3>
          <div class="tool-subtitle">De requisitos caoticos a spec ejecutable</div>
          <p>Captura de Jira, PDFs, Confluence, Slack, o lenguaje natural. Normaliza, deduplica, detecta conflictos, genera spec YAML.</p>
          <p>No genera codigo. Es infraestructura de preparacion.</p>
          <FeatureList
            variant="intake"
            items={[
              'Multi-source: Jira, PDFs, Slack, imagenes',
              'Deduplicacion y deteccion de conflictos',
              'Output YAML universal',
              'Trazabilidad completa',
            ]}
          />
          <a href="https://diego303.github.io/intake-docs/" target="_blank" rel="noopener noreferrer" class="btn btn-tool btn-tool--intake">Ir a documentacion</a>
        </div>
        <CodeBlock variant="dark" title="Terminal — intake collect">
          <span class="line"><span class="cm"># Captura desde multiples fuentes</span></span>
          <span class="line"><span class="pr">$ </span><span class="cmd">intake</span> <span class="fl">collect</span></span>
          <span class="line"><span class="fl">  --from</span> <span class="s">jira:PROJ-123</span></span>
          <span class="line"><span class="fl">  --from</span> <span class="s">pdf:specs/req.pdf</span></span>
          <span class="line"><span class="fl">  --from</span> <span class="s">slack:#dev</span></span>
          <span class="line"></span>
          <span class="line"><span class="o">  &#9723; 14 requisitos · 2 conflictos</span></span>
          <span class="line"><span class="o">  &#9723; Spec &rarr; .intake/spec.yaml</span></span>
        </CodeBlock>
      </div>
    </div>
  </section>

  <!-- ═══ ARCHITECT ═══ -->
  <section class="sec-architect" id="sec-a">
    <div class="container">
      <div class="tool-grid tool-grid--reversed">
        <div>
          <div class="phase">&#9651; Fase 02 — Implementacion</div>
          <h3>architect</h3>
          <div class="tool-subtitle">Control determinista para agentes de codigo</div>
          <p>Guardrails que el LLM no puede saltarse. Backend-agnostico. Cambia de modelo sin cambiar tus pipelines.</p>
          <FeatureList
            variant="architect"
            items={[
              'Ralph Loop: iteracion con verificacion',
              'Archivos protegidos, budget limits',
              '100+ proveedores, zero lock-in',
              'OWASP nativa, OpenTelemetry',
            ]}
          />
          <a href="https://diego303.github.io/architect-docs/" target="_blank" rel="noopener noreferrer" class="btn btn-tool btn-tool--architect">Ir a documentacion</a>
        </div>
        <CodeBlock variant="warm" title="Figura 03 — architect loop">
          <span class="line"><span class="pr">$ </span><span class="cmd">architect</span> <span class="fl">loop</span> <span class="s">"Modulo de pagos"</span></span>
          <span class="line"><span class="fl">  --check</span> <span class="s">"pytest tests/ -q"</span></span>
          <span class="line"><span class="fl">  --check</span> <span class="s">"vigil scan src/"</span></span>
          <span class="line"><span class="fl">  --budget</span> <span class="s">$2.00</span></span>
          <span class="line"></span>
          <span class="line"><span class="o">  &#9651; Loop 3/10</span></span>
          <span class="line"><span class="o">  &#10003; 18/18 passed · $0.089</span></span>
        </CodeBlock>
      </div>
    </div>
  </section>

  <!-- ═══ VIGIL ═══ -->
  <section class="sec-vigil" id="sec-v">
    <div class="container">
      <div class="tool-grid">
        <div>
          <div class="phase">&#9671; Fase 03 — Verificacion</div>
          <h3>vigil</h3>
          <div class="tool-subtitle">Security scanner para codigo IA</div>
          <p>Detecta dependencias alucinadas, slopsquatting, over-permissions, tests vacios. Determinista, sin LLMs.</p>
          <FeatureList
            variant="vigil"
            items={[
              'Dependencias fantasma en registries',
              'Typosquatting y slopsquatting',
              'Tests: asserts vacios, coverage falso',
              'Quality gate para CI/CD',
            ]}
          />
          <a href="https://diego303.github.io/vigil-docs/" target="_blank" rel="noopener noreferrer" class="btn btn-tool btn-tool--vigil">Ir a documentacion</a>
        </div>
        <CodeBlock variant="green" title="Terminal — vigil scan">
          <span class="line"><span class="pr">$ </span><span class="cmd">vigil</span> <span class="fl">scan</span> <span class="s">src/</span></span>
          <span class="line"></span>
          <span class="line"><span class="o">  &#9671; 47 archivos...</span></span>
          <span class="line" style="color:#EF4444">  &#10007; DEP-001 flask-helper (alucinada)</span>
          <span class="line" style="color:#EF4444">  &#10007; SEC-003 CORS disabled</span>
          <span class="line" style="color:#10B981">  &#10003; 45/47 limpios</span>
        </CodeBlock>
      </div>
    </div>
  </section>

  <!-- ═══ PIPELINE ═══ -->
  <section class="sec-pipeline">
    <div class="container">
      <SectionHeader
        tag="// Pipeline completo"
        title="Tres comandos. Cero supervision."
        subtitle="De ticket a PR verificado. Headless, auditable."
      />
      <div class="pipeline-code">
        <CodeBlock variant="dark" title="pipeline.sh">
          <Fragment>
            <span class="line"><span class="cm">#!/bin/bash</span></span>
            <span class="line"></span>
            <span class="line"><span class="cmd">intake</span> <span class="fl">collect --from</span> <span class="s">jira:SPRINT-42</span> <span class="fl">--out</span> <span class="s">spec.yaml</span></span>
            <span class="line"></span>
            <span class="line"><span class="cmd" style="color:#C85A32">architect</span> <span class="fl">loop</span> <span class="s">"Implementa spec.yaml"</span> <span class="fl">\</span></span>
            <span class="line">  <span class="fl">--check</span> <span class="s">"pytest && vigil scan src/"</span></span>
            <span class="line"></span>
            <span class="line"><span class="cmd" style="color:#10B981">vigil</span> <span class="fl">scan src/ --format junit</span></span>
          </Fragment>
        </CodeBlock>
      </div>
    </div>
  </section>

  <!-- ═══ PRINCIPLES ═══ -->
  <section class="sec-principles">
    <div class="container">
      <SectionHeader tag="// Principios" title="Construido sobre convicciones" />
      <div class="principles-grid">
        <PrincipleCard number="01" title="CLI-first" description="Si no cabe en un script, no sirve para CI/CD." />
        <PrincipleCard number="02" title="Determinismo" description="El LLM no puede saltarse tests ni quality gates." />
        <PrincipleCard number="03" title="Zero lock-in" description="Cambia de modelo sin tocar tu pipeline." />
        <PrincipleCard number="04" title="Open source" description="Codigo auditable que gobierna tu codigo." />
        <PrincipleCard number="05" title="Headless-first" description="Funciona a las 3am sin supervision." />
        <PrincipleCard number="06" title="Complementa" description="Cubrimos gaps que otros no ven." />
      </div>
    </div>
  </section>

  <!-- ═══ CTA ═══ -->
  <section class="sec-cta" id="cta">
    <div class="container">
      <h2>Tu pipeline de IA, bajo control</h2>
      <p>Instala y ejecuta tu primer pipeline con garantias.</p>
      <div class="cta-buttons">
        <a href="#" class="btn btn-primary">Documentacion</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* ═══════════════════════════════════════
     HERO
     ═══════════════════════════════════════ */
  .hero {
    background: #0a0a0c;
    color: #ededed;
    padding: 130px 0 60px;
    background-image: radial-gradient(
      ellipse 600px 400px at 50% 40%,
      rgba(200, 90, 50, 0.04),
      transparent
    );
  }

  .hero-top {
    text-align: center;
    margin-bottom: 64px;
    animation: fadeUp 0.5s ease-out both;
  }

  .hero-tag {
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.35);
    margin-bottom: 28px;
  }

  .hero h1 {
    font-family: var(--f-head);
    font-size: clamp(34px, 5vw, 56px);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.08;
    max-width: 680px;
    margin: 0 auto 20px;
  }

  .accent-green {
    color: #10B981;
  }

  .hero-subtitle {
    font-size: 17px;
    color: rgba(255, 255, 255, 0.5);
    max-width: 500px;
    margin: 0 auto 36px;
    font-weight: 300;
    line-height: 1.75;
  }

  .hero-buttons {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ═══ Journey Map ═══ */
  .journey {
    position: relative;
    max-width: 900px;
    margin: 0 auto;
    padding: 20px 0 40px;
    animation: fadeUp 0.5s ease-out 0.15s both;
  }

  .journey-svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  .journey-stops {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    position: relative;
    z-index: 2;
  }

  /* ═══════════════════════════════════════
     TOOL SECTIONS — Shared
     ═══════════════════════════════════════ */
  .tool-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
  }

  .tool-grid--reversed {
    direction: rtl;
  }

  .tool-grid--reversed > :global(*) {
    direction: ltr;
  }

  .phase {
    font-family: var(--f-mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .tool-subtitle {
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 20px;
  }

  .btn-tool {
    margin-top: 24px;
    border: 1px solid;
  }

  .btn-tool--intake {
    color: #ededed;
    border-color: rgba(237, 237, 237, 0.2);
  }
  .btn-tool--intake:hover {
    border-color: rgba(237, 237, 237, 0.4);
  }

  .btn-tool--architect {
    color: #C85A32;
    border-color: rgba(200, 90, 50, 0.3);
  }
  .btn-tool--architect:hover {
    border-color: rgba(200, 90, 50, 0.5);
  }

  .btn-tool--vigil {
    color: #10B981;
    border-color: rgba(16, 185, 129, 0.3);
  }
  .btn-tool--vigil:hover {
    border-color: rgba(16, 185, 129, 0.5);
  }

  /* ═══ INTAKE ═══ */
  .sec-intake {
    background: #050505;
    color: #ededed;
    padding: 100px 0;
    border-top: 2px solid #1f1f22;
    background-image: radial-gradient(
      ellipse 500px 300px at 25% 50%,
      rgba(237, 237, 237, 0.02),
      transparent
    );
  }

  .sec-intake .phase { color: #5a5a66; }
  .sec-intake h3 {
    font-family: var(--f-head);
    font-size: 32px;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #ededed;
    margin-bottom: 6px;
  }
  .sec-intake .tool-subtitle { color: #5a5a66; }
  .sec-intake p {
    font-size: 15px;
    color: #9999a5;
    line-height: 1.75;
    margin-bottom: 14px;
    font-weight: 300;
  }

  /* ═══ ARCHITECT ═══ */
  .sec-architect {
    background: #FDFBF7;
    color: #292524;
    padding: 100px 0;
    border-top: 2px solid #292524;
    background-image: radial-gradient(
      ellipse 500px 300px at 75% 50%,
      rgba(200, 90, 50, 0.04),
      transparent
    );
  }

  .sec-architect .phase { color: #57534E; }
  .sec-architect h3 {
    font-family: var(--f-head);
    font-size: 32px;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #C85A32;
    margin-bottom: 6px;
  }
  .sec-architect .tool-subtitle { color: #C85A32; }
  .sec-architect p {
    font-size: 15px;
    color: #57534E;
    line-height: 1.75;
    margin-bottom: 14px;
    font-weight: 300;
  }

  /* ═══ VIGIL ═══ */
  .sec-vigil {
    background: #F4F7F5;
    color: #022C22;
    padding: 100px 0;
    border-top: 2px solid #022C22;
    background-image: radial-gradient(
      ellipse 500px 300px at 25% 50%,
      rgba(16, 185, 129, 0.04),
      transparent
    );
  }

  .sec-vigil .phase { color: #064E3B; }
  .sec-vigil h3 {
    font-family: var(--f-head);
    font-size: 32px;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #064E3B;
    margin-bottom: 6px;
  }
  .sec-vigil .tool-subtitle { color: #10B981; }
  .sec-vigil p {
    font-size: 15px;
    color: #064E3B;
    line-height: 1.75;
    margin-bottom: 14px;
    font-weight: 300;
  }

  /* ═══ PIPELINE ═══ */
  .sec-pipeline {
    background: #0a0a0c;
    color: #ededed;
    padding: 100px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .pipeline-code {
    max-width: 680px;
    margin: 0 auto;
  }

  .pipeline-code :global(.cb-body) {
    line-height: 2;
  }

  /* ═══ PRINCIPLES ═══ */
  .sec-principles {
    background: #111114;
    color: #ededed;
    padding: 80px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .principles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }

  /* ═══ CTA ═══ */
  .sec-cta {
    background: #0a0a0c;
    color: #ededed;
    padding: 100px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    text-align: center;
  }

  .sec-cta h2 {
    font-family: var(--f-head);
    font-size: clamp(26px, 3.5vw, 40px);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: 16px;
  }

  .sec-cta p {
    font-size: 15px;
    color: rgba(255, 255, 255, 0.45);
    max-width: 440px;
    margin: 0 auto 32px;
    font-weight: 300;
  }

  .cta-buttons {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ═══ RESPONSIVE ═══ */
  @media (max-width: 900px) {
    .journey-stops {
      flex-direction: column;
      align-items: center;
      gap: 32px;
    }

    .journey-svg {
      display: none;
    }

    .tool-grid,
    .tool-grid--reversed {
      grid-template-columns: 1fr;
      gap: 32px;
      direction: ltr;
    }

    .principles-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .hero {
      padding: 110px 0 40px;
    }

    .hero-buttons {
      flex-direction: column;
      align-items: stretch;
    }

    .hero-buttons :global(.btn) {
      text-align: center;
    }
  }
</style>

<script>
  function lerpColor(a: string, b: string, t: number): string {
    const ah = parseInt(a.slice(1), 16),
      bh = parseInt(b.slice(1), 16);
    const ar = ah >> 16,
      ag = (ah >> 8) & 0xff,
      ab = ah & 0xff;
    const br = bh >> 16,
      bg = (bh >> 8) & 0xff,
      bb = bh & 0xff;
    return `rgb(${Math.round(ar + (br - ar) * t)},${Math.round(ag + (bg - ag) * t)},${Math.round(ab + (bb - ab) * t)})`;
  }

  function getPathColor(t: number): string {
    if (t <= 0.5) return lerpColor('#ededed', '#C85A32', t * 2);
    return lerpColor('#C85A32', '#10B981', (t - 0.5) * 2);
  }

  function easeInOut(t: number): number {
    return t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
  }

  const SVG_NS = 'http://www.w3.org/2000/svg';

  interface ActiveDot {
    outer: SVGCircleElement;
    inner: SVGCircleElement;
    grad: SVGRadialGradientElement;
    glowStops: NodeListOf<SVGStopElement>;
    startTime: number;
    duration: number;
  }

  let pathRef: SVGPathElement | null = null;
  let dotsStarted = false;
  const activeDots: ActiveDot[] = [];

  function drawJourneyPath() {
    const journey = document.querySelector('.journey');
    const dots = document.querySelectorAll('.stop-dot');
    const svg = document.getElementById('journeySvg');
    const pathDash = document.getElementById('pathDash');
    const pathGlow = document.getElementById('pathGlow') as SVGPathElement | null;
    if (!journey || dots.length < 3 || !svg || !pathDash || !pathGlow) return;

    const jRect = journey.getBoundingClientRect();
    const centers = Array.from(dots).map((dot) => {
      const r = dot.getBoundingClientRect();
      return {
        x: r.left + r.width / 2 - jRect.left,
        y: r.top + r.height / 2 - jRect.top,
      };
    });

    const [a, b, c] = centers;
    const cp1x = a.x + (b.x - a.x) * 0.55,
      cp1y = a.y;
    const cp2x = a.x + (b.x - a.x) * 0.45,
      cp2y = b.y;
    const cp3x = b.x + (c.x - b.x) * 0.55,
      cp3y = b.y;
    const cp4x = b.x + (c.x - b.x) * 0.45,
      cp4y = c.y;
    const d = `M ${a.x} ${a.y} C ${cp1x} ${cp1y}, ${cp2x} ${cp2y}, ${b.x} ${b.y} C ${cp3x} ${cp3y}, ${cp4x} ${cp4y}, ${c.x} ${c.y}`;

    pathDash.setAttribute('d', d);
    pathGlow.setAttribute('d', d);

    const len = pathGlow.getTotalLength();
    pathGlow.style.strokeDasharray = String(len);
    pathGlow.style.strokeDashoffset = String(len);
    pathGlow.style.animation = 'none';
    pathGlow.offsetHeight; // force reflow
    pathGlow.style.animation = 'drawPath 1.5s ease-out 0.3s forwards';

    pathRef = pathGlow;

    if (!dotsStarted) {
      dotsStarted = true;
      setTimeout(() => {
        startDotLoop();
        requestAnimationFrame(animateAllDots);
      }, 1800);
    }
  }

  function spawnDot() {
    if (!pathRef) return;
    const container = document.getElementById('dotsContainer');
    const defs = document.querySelector('#journeySvg defs');
    if (!container || !defs) return;

    const duration = 3500 + Math.random() * 2000;
    const outerR = 10 + Math.random() * 5;
    const innerR = 2.5 + Math.random() * 1.5;
    const id = 'dg' + Math.random().toString(36).slice(2, 8);

    const grad = document.createElementNS(SVG_NS, 'radialGradient');
    grad.setAttribute('id', id);

    const s1 = document.createElementNS(SVG_NS, 'stop');
    s1.setAttribute('offset', '0%');
    s1.setAttribute('stop-color', '#ededed');
    s1.setAttribute('stop-opacity', '0.9');

    const s2 = document.createElementNS(SVG_NS, 'stop');
    s2.setAttribute('offset', '40%');
    s2.setAttribute('stop-color', '#ededed');
    s2.setAttribute('stop-opacity', '0.3');

    const s3 = document.createElementNS(SVG_NS, 'stop');
    s3.setAttribute('offset', '100%');
    s3.setAttribute('stop-color', '#ededed');
    s3.setAttribute('stop-opacity', '0');

    grad.appendChild(s1);
    grad.appendChild(s2);
    grad.appendChild(s3);
    defs.appendChild(grad);

    const outer = document.createElementNS(SVG_NS, 'circle');
    outer.setAttribute('r', String(outerR));
    outer.setAttribute('fill', `url(#${id})`);
    outer.setAttribute('opacity', '0');

    const inner = document.createElementNS(SVG_NS, 'circle');
    inner.setAttribute('r', String(innerR));
    inner.setAttribute('fill', '#ededed');
    inner.setAttribute('opacity', '0');

    container.appendChild(outer);
    container.appendChild(inner);

    activeDots.push({
      outer,
      inner,
      grad,
      glowStops: grad.querySelectorAll('stop'),
      startTime: performance.now(),
      duration,
    });
  }

  function startDotLoop() {
    spawnDot();

    function scheduleNext() {
      const delay = 1200 + Math.random() * 1800;
      setTimeout(() => {
        if (activeDots.length < 3) {
          spawnDot();
        }
        scheduleNext();
      }, delay);
    }
    scheduleNext();
  }

  function animateAllDots(timestamp: number) {
    for (let i = activeDots.length - 1; i >= 0; i--) {
      const dot = activeDots[i];
      const elapsed = timestamp - dot.startTime;
      const rawT = elapsed / dot.duration;

      if (rawT > 1.15) {
        dot.outer.remove();
        dot.inner.remove();
        dot.grad.remove();
        activeDots.splice(i, 1);
        continue;
      }

      const t = Math.min(rawT, 1);
      const eased = easeInOut(t);

      try {
        const len = pathRef!.getTotalLength();
        const point = pathRef!.getPointAtLength(eased * len);
        const color = getPathColor(eased);

        dot.outer.setAttribute('cx', String(point.x));
        dot.outer.setAttribute('cy', String(point.y));
        dot.inner.setAttribute('cx', String(point.x));
        dot.inner.setAttribute('cy', String(point.y));
        dot.inner.setAttribute('fill', color);

        dot.glowStops.forEach((stop) => {
          if (parseFloat(stop.getAttribute('stop-opacity') || '0') > 0) {
            stop.setAttribute('stop-color', color);
          }
        });

        let opacity = 1;
        if (t < 0.06) opacity = t / 0.06;
        else if (t > 0.9) opacity = Math.max(0, (1 - t) / 0.1);
        if (rawT > 1) opacity = Math.max(0, 1 - (rawT - 1) / 0.15);

        dot.outer.setAttribute('opacity', String(opacity));
        dot.inner.setAttribute('opacity', String(opacity));
      } catch {
        // Path may not be ready yet
      }
    }

    requestAnimationFrame(animateAllDots);
  }

  window.addEventListener('load', drawJourneyPath);
  window.addEventListener('resize', drawJourneyPath);
</script>
